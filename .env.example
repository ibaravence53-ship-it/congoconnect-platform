# Port d ecoute du serveur HTTP
PORT=3000

# Masquer les codes OTP dans les reponses API en production (true/false)
HIDE_OTP_IN_RESPONSE=false

# Secret de signature/verification des jetons cc1. (obligatoire en production)
CONGOCONNECT_TOKEN_SECRET=replace-with-a-strong-random-secret

# Connexion Redis pour OTP et revocation/rate-limiting (optionnel : repli sur memory si vide)
REDIS_URL=

# Connexion PostgreSQL pour la persistance d audit (optionnel : repli sur memory+file si vide)
DATABASE_URL=
